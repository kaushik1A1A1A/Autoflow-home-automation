# =====================================================================
# .env — example
# =====================================================================
#
# Copy to `.env` beside docker-compose.yml. Excluded by .gitignore.
# Docker Compose reads this file automatically and passes the values to
# the containers declared with `env_file: - .env`.

# --- DVR credentials ----------------------------------------------------
# go2rtc expands ${DVR_USER} and ${DVR_PASS} in its config at load time,
# which keeps the credentials out of go2rtc.yaml and therefore out of git.
DVR_USER=CHANGEME
DVR_PASS=CHANGEME

# --- DVR / camera network ----------------------------------------------
# Address of the recorder. Kept here rather than in committed config so
# the repository carries no network topology.
DVR_HOST=CHANGEME

# --- Host addressing ----------------------------------------------------
# Address of the machine running Home Assistant, used where a full URL is
# required (the media player cannot resolve relative /local/ paths).
HA_HOST=CHANGEME
HA_PORT=8123

# --- Alarm listener (services/dvr_alarm.py) -----------------------------
# The interface this machine presents on the recorder's network. The
# listener binds here specifically rather than to all interfaces. If the
# interface is down it waits and retries instead of exiting, so an
# unplugged cable does not produce a systemd restart loop.
DVR_LISTEN_HOST=CHANGEME

# Webhook identifier the listener posts events to. Must match the
# webhook_id in the corresponding automation. Generate a fresh random
# value; treat it as a credential, because anyone who learns it can
# inject events.
DVR_WEBHOOK_ID=CHANGEME

# Which camera this listener reports events for. The recorder's alarm
# protocol does not identify the channel, so it is declared here.
DVR_CAMERA=camera_1

# --- Host account (services/watchdog.py, scripts/*.sh) ------------------
# The unprivileged account the services run as. Used to locate config
# paths and to read the right crontab.
AUTOFLOW_USER=CHANGEME

# --- Backups (scripts/backup_ha.sh) -------------------------------------
# Remote target for off-machine backup copies. Bucket names are globally
# unique and can be probed by anyone who learns them, so this is never
# committed.
BACKUP_BUCKET=CHANGEME
