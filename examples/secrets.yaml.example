# =====================================================================
# secrets.yaml — example
# =====================================================================
#
# Copy to the Home Assistant config directory as `secrets.yaml` and fill
# in real values. That file is excluded by .gitignore and must never be
# committed.
#
# Referenced from YAML as:  password: !secret dvr_password

# --- DVR / camera system ------------------------------------------------
# Username and password for the NVR/DVR. Also used by go2rtc for the RTSP
# stream URLs, which is why those URLs are parameterised rather than
# written out in full — an RTSP URL with credentials embedded ends up in
# dashboards, logs and screenshots.
dvr_username: CHANGEME
dvr_password: CHANGEME

# --- Outbound mail ------------------------------------------------------
# A Gmail account needs an App Password here, not the account password —
# a normal password is rejected. Create one at
# https://myaccount.google.com/apppasswords after enabling 2-Step
# Verification.
smtp_username: CHANGEME
smtp_password: CHANGEME
report_recipient: CHANGEME@example.com

# --- Kiosk -------------------------------------------------------------
# PIN or pattern used to release the on-screen lock.
kiosk_pin: CHANGEME

# --- Webhooks -----------------------------------------------------------
# Random, unguessable identifier used by the alarm listener to post events
# into Home Assistant. Generate a fresh one; do not reuse an example.
#   python3 -c "import secrets; print(secrets.token_hex(8))"
dvr_alarm_webhook_id: CHANGEME
